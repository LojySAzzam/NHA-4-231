    "import importlib\n",
    "import os\n",
    "import sys\n",
    "import glob\n",
    "import time\n",
    "import json\n",
    "import random\n",
    "import getpass\n",
    "import re \n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import mlflow\n",
    "import mlflow.sklearn\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.dates as mdates\n",
    "from datetime import datetime, timedelta\n",
    "from rouge_score import rouge_scorer\n",
    "import nltk\n",
    "from nltk.translate.bleu_score import sentence_bleu, SmoothingFunction\n",
    "\n",
    "nltk.download('punkt', quiet=True)\n",
    "nltk.download('punkt_tab', quiet=True)\n",
    "\n",
    "# Make sure Python can find the src/ package\n",
    "# 1. Define your dynamic project root\n",
    "PROJECT_ROOT = os.path.abspath('..')\n",
    "if PROJECT_ROOT not in sys.path:\n",
    "    sys.path.append(PROJECT_ROOT)\n",
    "    \n",
    "mlruns_dir = os.path.join(PROJECT_ROOT, \"mlruns\")\n",
    "\n",
    "# 2. Automatically find and repair absolute user paths in the history metadata\n",
    "if os.path.exists(mlruns_dir):\n",
    "    # Search for all meta.yaml files inside your tracking history\n",
    "    meta_files = glob.glob(os.path.join(mlruns_dir, \"**/meta.yaml\"), recursive=True)\n",
    "    current_user = getpass.getuser()\n",
    "    \n",
    "    for meta_file in meta_files:\n",
    "        with open(meta_file, 'r', encoding='utf-8') as f:\n",
    "            content = f.read()\n",
    "        \n",
    "        # Check if the file contains an alien 'Users/xxxx' path that isn't the current runtime environment\n",
    "        # This pattern catches \"Users/anyname\" or \"Users\\anyname\" regardless of slashes\n",
    "        pattern = r\"Users[/\\\\]([^/\\\\]+)\"\n",
    "        match = re.search(pattern, content)\n",
    "        \n",
    "        if match:\n",
    "            old_path_segment = match.group(1)\n",
    "            # Dynamically extract whatever username string was baked into this file's artifact_uri\n",
    "            try:\n",
    "                # Isolates the old user name segment from the string path\n",
    "                old_path_segment = content.split(\"Users/\")[1].split(\"/\")[0]\n",
    "                current_user = getpass.getuser() # Gets the name of the teammate currently running the code\n",
    "                \n",
    "                if old_path_segment != current_user:\n",
    "                    # Swap the old username path with the current user's local path name dynamically\n",
    "                    fixed_content = content.replace(f\"Users/{old_path_segment}\", f\"Users/{current_user}\")\n",
    "                    # Also catch Windows backslash formats just in case\n",
    "                    fixed_content = fixed_content.replace(f\"Users\\\\{old_path_segment}\", f\"Users\\\\{current_user}\")\n",
    "                    \n",
    "                    with open(meta_file, 'w', encoding='utf-8') as f:\n",
    "                            f.write(fixed_content)\n",
    "                    print(f\"🔧 Updated path mapping for {os.path.basename(os.path.dirname(meta_file))} to user: {current_user}.\")\n",
    "            except IndexError:\n",
    "                pass # Fail silently if the structure differs\n",
    "\n",
    "import src.rag_chain as rag_chain\n",
    "rag_chain = importlib.reload(rag_chain)\n",
    "load_all      = rag_chain.load_all\n",
    "ask           = rag_chain.ask\n",
    "rebuild_index = rag_chain.rebuild_index\n",
    "\n",
    "load_all()\n",
    "print('All models loaded.')"
   ]
