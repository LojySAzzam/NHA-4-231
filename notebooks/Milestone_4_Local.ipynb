    "import os\n",
    "import mlflow\n",
    "\n",
    "# Force MLflow to allow the local filesystem store (bypasses maintenance mode exception)\n",
    "os.environ[\"MLFLOW_ALLOW_FILE_STORE\"] = \"true\"\n",
    "\n",
    "# ── MLflow setup ──────────────────────────────────────────────────────────────\n",
    "MLFLOW_EXPERIMENT = \"rag-support-chatbot\"\n",
    "MLRUNS_DIR        = os.path.join(PROJECT_ROOT, \"mlruns\")\n",
    "\n",
    "# Convert Windows backslashes to forward slashes for MLflow URL compatibility\n",
    "local_tracking_uri = f\"file:///{MLRUNS_DIR.replace(os.sep, '/')}\"\n",
    "mlflow.set_tracking_uri(local_tracking_uri)\n",
    "\n",
    "# Initialize or set the active experiment\n",
    "mlflow.set_experiment(MLFLOW_EXPERIMENT)\n",
    "\n",
    "# Initialize evaluation metrics\n",
    "rouge  = rouge_scorer.RougeScorer(['rouge1', 'rouge2', 'rougeL'], use_stemmer=True)\n",
    "smooth = SmoothingFunction().method1\n",
    "\n",
    "print(f'MLflow tracking URI : {local_tracking_uri}')\n",
    "print(f'Experiment name     : {MLFLOW_EXPERIMENT}')\n",
    "print('MLflow ready.')"
   ]
